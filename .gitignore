# Generated world save data (chunk files) - not source, regenerated by playing the game.
saves/

# Live-controller test harness output (screenshots) - regenerated by running the harness.
test-output/

# Real Minecraft textures copied from the user's own local game assets for personal use -
# never commit/publish these, they're Mojang's copyrighted files, not ours to redistribute.
textures/

# Same policy as textures/ above - real Minecraft sound assets, copied locally from the user's
# own minecraft-sounds/ dump for personal use, never committed/redistributed.
sounds/

